# Скопіюйте у .env і підставте свій ключ
ANTHROPIC_API_KEY=sk-ant-...

# Необовʼязково
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_TOKENS=1200
MAX_TURNS=6

# Qdrant — НЕ потрібен для заняття: за замовчуванням працює вбудований :memory:
# QDRANT_URL=http://localhost:6333        # свій сервер у docker — теж без ключа
# QDRANT_URL=https://xxx.cloud.qdrant.io  # хмара:
# QDRANT_API_KEY=...                      #   лише тут потрібен ключ
