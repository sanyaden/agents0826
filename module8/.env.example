# Скопіюйте у .env і підставте свій ключ
ANTHROPIC_API_KEY=sk-ant-...

# Необовʼязково
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_TOKENS=1200
MAX_TURNS=6

# ── Бекенди трейсингу (module7, otel_tracing.py) ──────────────
# Жоден не обовʼязковий: без них працює --backend console.
# Порівняйте, скільки треба для кожного — це і є вся різниця.

# Phoenix: нічого не треба, лише `phoenix serve` в іншому терміналі
# PHOENIX_HOST=http://localhost:6006

# Langfuse: Project Settings → API keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith: smith.langchain.com → Settings.
# Регіон обовʼязково свій — ключ ЄС на американському хості дасть 403:
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agentpro-m7
# LANGSMITH_HOST=https://eu.api.smith.langchain.com   # США: без префікса eu.

# Будь-що інше з OTLP: Datadog, Grafana, Jaeger, свій колектор
# OTEL_EXPORTER_OTLP_ENDPOINT=https://.../v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20...
